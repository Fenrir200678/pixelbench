{
  "id": "zimage-turbo-t2i",
  "name": "Z-Image Turbo",
  "short": "Z-Image Turbo",
  "tools": ["create", "upscale"],
  "source": "https://github.com/Comfy-Org/workflow_templates/blob/main/templates/image_z_image_turbo.json",
  "notes": "Text-zu-Bild mit Z-Image Turbo nach der Comfy-Org-Vorlage.",
  "workflow": "zimage-turbo-t2i.json",
  "nodes": [
    "UNETLoader",
    "CLIPLoader",
    "VAELoader",
    "ModelSamplingAuraFlow",
    "CLIPTextEncode",
    "ConditioningZeroOut",
    "EmptySD3LatentImage",
    "KSampler",
    "VAEDecode",
    "PreviewImage"
  ],
  "sizes": {
    "grid": 16,
    "min": 256,
    "max": 2048,
    "area": 4194304,
    "target": 1024
  },
  "models": [
    {
      "node": "unet",
      "input": "unet_name",
      "category": "diffusion_models",
      "label": "Z-Image Turbo Diffusionsmodell",
      "files": [
        "z_image_turbo_bf16.safetensors",
        "SwarmUI_Z-Image-Turbo-FP8Mix.safetensors",
        "cyberrealisticZImage_v90_fp8.safetensors"
      ]
    },
    {
      "node": "clip",
      "input": "clip_name",
      "category": "text_encoders",
      "label": "Qwen3 4B Textencoder",
      "files": ["qwen_3_4b.safetensors"]
    },
    {
      "node": "vae",
      "input": "vae_name",
      "category": "vae",
      "label": "FLUX VAE",
      "files": ["ae.safetensors"]
    }
  ],
  "parameters": {
    "steps": { "label": "Steps", "default": 8, "min": 1, "max": 30, "step": 1 },
    "sampler": { "label": "Sampler", "default": "res_multistep" },
    "scheduler": { "label": "Scheduler", "default": "simple" },
    "shift": { "label": "Shift", "default": 3, "min": 1, "max": 10, "step": 0.5 }
  },
  "bindings": {
    "width": ["latent", "width"],
    "height": ["latent", "height"],
    "prompt": ["positive", "text"],
    "seed": ["sample", "seed"],
    "steps": ["sample", "steps"],
    "sampler": ["sample", "sampler_name"],
    "scheduler": ["sample", "scheduler"],
    "shift": ["shift", "shift"]
  },
  "fixed": {
    "CFG": "1,0 · Vorgabe der distillierten Vorlage"
  },
  "lora": { "model": ["unet", 0], "family": "zimage" },
  "img2img": { "denoise": ["sample", "denoise"] }
}

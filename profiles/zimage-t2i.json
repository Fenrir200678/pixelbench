{
  "id": "zimage-t2i",
  "name": "Z-Image",
  "short": "Z-Image",
  "tools": ["create", "upscale"],
  "source": "https://github.com/Comfy-Org/workflow_templates/blob/main/templates/image_z_image.json",
  "notes": "Text to image with the Z-Image base model after the Comfy-Org template: 25 steps, CFG 4, res_multistep, shift 3 and a negative prompt.",
  "workflow": "zimage-t2i.json",
  "nodes": [
    "UNETLoader",
    "CLIPLoader",
    "VAELoader",
    "ModelSamplingAuraFlow",
    "CLIPTextEncode",
    "EmptySD3LatentImage",
    "KSampler",
    "VAEDecode",
    "PreviewImage"
  ],
  "sizes": {
    "grid": 16,
    "min": 256,
    "max": 2048,
    "area": 4194304,
    "target": 1024
  },
  "models": [
    {
      "node": "unet",
      "input": "unet_name",
      "category": "diffusion_models",
      "label": "Z-Image Diffusionsmodell",
      "files": ["z_image_bf16.safetensors", "z_image_int8_convrot.safetensors"]
    },
    {
      "node": "clip",
      "input": "clip_name",
      "category": "text_encoders",
      "label": "Qwen3 4B Textencoder",
      "files": ["qwen_3_4b.safetensors"]
    },
    {
      "node": "vae",
      "input": "vae_name",
      "category": "vae",
      "label": "FLUX VAE",
      "files": ["ae.safetensors"]
    }
  ],
  "parameters": {
    "steps": { "label": "Steps", "default": 25, "min": 1, "max": 100, "step": 1 },
    "sampler": { "label": "Sampler", "default": "res_multistep" },
    "scheduler": { "label": "Scheduler", "default": "simple" },
    "cfg": { "label": "CFG", "default": 4, "min": 1, "max": 10, "step": 0.5 },
    "shift": { "label": "Shift", "default": 3, "min": 1, "max": 10, "step": 0.5 }
  },
  "bindings": {
    "width": ["latent", "width"],
    "height": ["latent", "height"],
    "prompt": ["positive", "text"],
    "negative": ["negative", "text"],
    "seed": ["sample", "seed"],
    "steps": ["sample", "steps"],
    "sampler": ["sample", "sampler_name"],
    "scheduler": ["sample", "scheduler"],
    "cfg": ["sample", "cfg"],
    "shift": ["shift", "shift"]
  },
  "negative": true,
  "lora": { "model": ["unet", 0], "family": "zimage" },
  "img2img": { "denoise": ["sample", "denoise"] }
}

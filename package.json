{
  "name": "pixelbench",
  "version": "0.2.0-beta.1",
  "private": true,
  "author": "Fenrir",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run typecheck && vite build",
    "start": "node server/index.mjs",
    "test": "npm run build && node --test checks/*.test.mjs",
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@fontsource-variable/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "globals": "17.14.0",
    "i18next": "^27.1.5",
    "lucide-react": "1.75.0",
    "playwright-core": "1.65.1",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^18.0.2",
    "react-resizable-panels": "^4.24.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8"
  },
  "dependencies": {
    "pngjs": "7.0.0",
    "semver": "7.8.6"
  }
}
